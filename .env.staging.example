# Staging: development.periodkaakura.com on Hostinger.
# Copy to .env on the server (scripts/server-deploy.sh does this on first run),
# then fill in the values marked CHANGE.

APP_NAME="Period Kaa Kura"
# Anything other than "production" adds noindex headers so search engines skip staging.
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://development.periodkaakura.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# SQLite needs no setup on shared hosting; the file lives in database/database.sqlite.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue worker on shared hosting, so jobs run immediately.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# CHANGE: comma-separated emails allowed into /admin.
ADMIN_EMAILS=

# CHANGE: send staging contact-form messages to yourself, not the creators.
CONTACT_RECIPIENT=

# Mail through a Hostinger mailbox (Emails in hPanel). Until it's set up,
# use MAIL_MAILER=log and messages are written to storage/logs instead.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@periodkaakura.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
